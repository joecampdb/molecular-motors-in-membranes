; production, 2 fs, 100 ns per replica; Nose-Hoover 298 K, Parrinello-Rahman semi-isotropic 1 bar
integrator              = md
dt                      = 0.002
nsteps                  = 50000000
nstlog                  = 50000
nstenergy               = 5000
nstxout-compressed      = 5000
compressed-x-precision  = 1000
nstlist                 = 20
cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
DispCorr                = EnerPres
fourierspacing          = 0.12
pme-order               = 4
ewald-rtol              = 1e-5
constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-iter              = 1
lincs-order             = 4
comm-mode               = Linear
nstcomm                 = 100
comm-grps               = System
tcoupl                  = Nose-Hoover
tc-grps                 = LIPID SOLVENT LIG
tau-t                   = 1.0 1.0 1.0
ref-t                   = 298 298 298
pcoupl                  = Parrinello-Rahman
pcoupltype              = semiisotropic
tau-p                   = 5.0
compressibility         = 4.5e-5 4.5e-5
ref-p                   = 1.0 1.0
continuation            = yes
gen-vel                 = no
