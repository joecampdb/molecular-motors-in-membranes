; NVT warm-up, 1 fs, 100 ps, velocity rescaling, no restraints (see README for the rationale)
integrator              = md
dt                      = 0.001
nsteps                  = 100000
nstlog                  = 5000
nstenergy               = 5000
nstxout-compressed      = 10000
nstlist                 = 20
cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
DispCorr                = EnerPres
fourierspacing          = 0.12
pme-order               = 4
ewald-rtol              = 1e-5
constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-iter              = 1
lincs-order             = 4
comm-mode               = Linear
nstcomm                 = 100
comm-grps               = System
tcoupl                  = V-rescale
tc-grps                 = LIPID SOLVENT LIG
tau-t                   = 1.0 1.0 1.0
ref-t                   = 298 298 298
pcoupl                  = no
gen-vel                 = yes
gen-temp                = 298
gen-seed                = -1
